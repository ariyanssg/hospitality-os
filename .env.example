# --- Vela local development environment ---
# Copy to .env and adjust as needed. `docker compose up -d` provisions the stack below.

NODE_ENV=development

# PostgreSQL — the application connects as a NON-superuser, NON-BYPASSRLS role (doc 05 §2).
# The migration/admin role is separate and never reachable from request handlers.
# Host port 5434 (not 5432/5433) sidesteps a clash with native Windows PostgreSQL 16/18.
DATABASE_URL=postgres://vela_app:vela_app@localhost:5434/vela
DATABASE_ADMIN_URL=postgres://vela_admin:vela_admin@localhost:5434/vela

# Redis — cache, BullMQ queues, Redis Streams (event transport), idempotency keys.
REDIS_URL=redis://localhost:6379

# OpenSearch — search + analytics projections.
OPENSEARCH_URL=http://localhost:9200

# Better Auth
BETTER_AUTH_SECRET=dev-secret-change-me-in-production-0123456789abcdef
BETTER_AUTH_URL=http://localhost:4000

# API
API_PORT=4000
API_HOST=0.0.0.0
APP_ROLE=api

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000
